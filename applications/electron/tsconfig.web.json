{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "test/**/*",
    "test/types.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@components/*": [
        "src/renderer/src/components/*"
      ],
      "@state": [
        "src/renderer/src/state/index.ts"
      ],
      "@state/*": [
        "src/renderer/src/state/*"
      ],
      "@transport": [
        "src/renderer/src/transport/index.ts"
      ],
      "@transport/*": [
        "src/renderer/src/transport/*"
      ],
      "@test-support": [
        "src/renderer/src/test-support/index.ts"
      ],
      "@test-support/*": [
        "src/renderer/src/test-support/*"
      ]
    }
  }
}
