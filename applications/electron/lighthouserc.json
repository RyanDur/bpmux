{
  "ci": {
    "collect": {
      "staticDistDir": "out/renderer",
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.85
          }
        ]
      }
    }
  }
}
