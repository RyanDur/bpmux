#!/bin/bash
# Pre-push hook: Playwright e2e + file-size gate.
#
# Install: symlink or copy this file to .git/hooks/pre-push and make
# it executable.
#
# Restructure 2026-05-01: cargo nextest + npm test:unit + cargo
# audit moved to pre-commit (fast-feedback). Pre-push now runs ONLY
# npm test:e2e (the 12-min surface). Catches unit-class regressions
# at commit-time instead of push-time.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -d "$REPO_ROOT/applications/electron/node_modules" ]; then
    echo "ERROR: applications/electron/node_modules not found at $REPO_ROOT." >&2
    echo "Install with: (cd $REPO_ROOT/applications/electron && npm install)" >&2
    exit 1
fi

echo "Running pre-push quality gates..."

# #534 slice 2 + 2026-05-02 Bash-tool 10-min-cap workaround: split
# Playwright e2e into 3 parallel invocations to fit each under the
# 10-min cap. Prior 2-way split's group A (48 desk-check+others) hit
# 10.7 min — over cap. 3-way rebalances:
#   group-A: 22 desk-check-3{3-7}* + app + dev-smoke      (~25 specs)
#   group-B: 21 desk-check-3{8,9,4,5}* + port-isolation
#            + real-backend                               (~23 specs)
#   group-C: 56 human-*                                   (~56 specs)
# Each invocation runs Playwright's default workers=2; total concurrent
# Electrons across the hook = 6. Each writes to its own log; logs
# concatenated post-wait. `--reporter=dot` keeps stdout volume low.
e2e_a_log=$(mktemp); e2e_a_exit=0
e2e_b_log=$(mktemp); e2e_b_exit=0
e2e_c_log=$(mktemp); e2e_c_exit=0

(cd "$REPO_ROOT/applications/electron" \
  && npx playwright test --reporter=dot \
       tests/desk-check-3[3-6]*.spec.ts tests/desk-check-37[01].spec.ts \
       tests/app.spec.ts tests/dev-smoke-*) \
  >"$e2e_a_log" 2>&1 &
e2e_a_pid=$!

(cd "$REPO_ROOT/applications/electron" \
  && npx playwright test --reporter=dot \
       tests/desk-check-37[2-9].spec.ts tests/desk-check-3[89]*.spec.ts \
       tests/desk-check-4*.spec.ts \
       tests/port-isolation.spec.ts tests/real-backend.spec.ts) \
  >"$e2e_b_log" 2>&1 &
e2e_b_pid=$!

(cd "$REPO_ROOT/applications/electron" \
  && npx playwright test --reporter=dot tests/human-*) \
  >"$e2e_c_log" 2>&1 &
e2e_c_pid=$!

wait $e2e_a_pid || e2e_a_exit=$?
wait $e2e_b_pid || e2e_b_exit=$?
wait $e2e_c_pid || e2e_c_exit=$?

echo "--- group A (desk-check 333-371 + app + smoke) ---"
cat "$e2e_a_log"
echo "--- group B (desk-check 372+ + port-isolation + real-backend) ---"
cat "$e2e_b_log"
echo "--- group C (human-*) ---"
cat "$e2e_c_log"
rm -f "$e2e_a_log" "$e2e_b_log" "$e2e_c_log"

for_each_exit_check() {
    local label=$1 code=$2
    if [ $code -ne 0 ] && [ $code -ne 141 ]; then
        echo "FAIL: $label exited $code"
        exit $code
    fi
    if [ $code -eq 141 ]; then
        echo "WARN: $label exited 141 (SIGPIPE — reporter pipe-close, not test failure)"
    fi
}

for_each_exit_check "e2e group A" $e2e_a_exit
for_each_exit_check "e2e group B" $e2e_b_exit
for_each_exit_check "e2e group C" $e2e_c_exit

MAX_LINES=400
echo "Checking file sizes..."
oversized=""
while IFS= read -r f; do
    lines=$(wc -l < "$f")
    if [ "$lines" -gt "$MAX_LINES" ]; then
        oversized="${oversized}  ${f}: ${lines} lines (max ${MAX_LINES})\n"
    fi
done < <(find applications/*/src -name "*.rs" -not -name "*test*" -not -path "*/target/*" -not -path "*/node_modules/*")
if [ -n "$oversized" ]; then
    echo "WARNING: Files exceed ${MAX_LINES}-line limit:"
    echo -e "$oversized"
    echo "Consider splitting before the next push."
fi

echo "All checks passed."
