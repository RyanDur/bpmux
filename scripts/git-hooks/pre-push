#!/bin/bash
# Pre-push hook: Playwright e2e + file-size gate.
#
# Install: symlink or copy this file to .git/hooks/pre-push and make
# it executable.
#
# Restructure 2026-05-01: cargo nextest + npm test:unit + cargo
# audit moved to pre-commit (fast-feedback). Pre-push runs ONLY
# Playwright e2e — the surface that's too slow for every commit.
#
# Restructure 2026-05-04 (#1152): switched from 3 bash-grouped
# Playwright invocations to 6 Playwright-native --shard=N/6 runs,
# mirroring the CI matrix in .github/workflows/ci.yml. Each shard
# runs on its own log; logs concatenated post-wait. Wall-clock
# target <7min on baseline dev machine.
#
# Workers tuned to 3 here vs 4 in CI: CI shards run on dedicated
# runner VMs (per-shard concurrency = 4 workers × 1 VM = 4 concurrent
# Electrons). Locally all 6 shards spawn on one machine, so 6 × 4 =
# 24 concurrent Electrons starves time-sensitive specs (#1158
# offline-board F8/F9 timeout-out under 24-way contention; safe at
# 18-way). This matches the story's flake-class clause: scope-cut
# the local-side parallelism rather than scope-cutting test
# coverage, since CI's shard-VMs see the full workers=4.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -d "$REPO_ROOT/applications/electron/node_modules" ]; then
    echo "ERROR: applications/electron/node_modules not found at $REPO_ROOT." >&2
    echo "Install with: (cd $REPO_ROOT/applications/electron && npm install)" >&2
    exit 1
fi

echo "Running pre-push quality gates (6 Playwright shards × workers=3)..."

# Shard logs + exit codes — declared before launch so wait/cat
# loops are uniform.
declare -a shard_logs shard_pids shard_exits
total_shards=6
for i in $(seq 1 $total_shards); do
    shard_logs[$i]=$(mktemp)
    shard_exits[$i]=0
done

for i in $(seq 1 $total_shards); do
    log="${shard_logs[$i]}"
    (cd "$REPO_ROOT/applications/electron" \
      && npx playwright test --reporter=dot \
           --shard="$i/$total_shards" --workers=3) \
      >"$log" 2>&1 &
    shard_pids[$i]=$!
done

for i in $(seq 1 $total_shards); do
    wait "${shard_pids[$i]}" || shard_exits[$i]=$?
done

for i in $(seq 1 $total_shards); do
    echo "--- shard $i/$total_shards ---"
    cat "${shard_logs[$i]}"
    rm -f "${shard_logs[$i]}"
done

for_each_exit_check() {
    local label=$1 code=$2
    if [ $code -ne 0 ] && [ $code -ne 141 ]; then
        echo "FAIL: $label exited $code"
        exit $code
    fi
    if [ $code -eq 141 ]; then
        echo "WARN: $label exited 141 (SIGPIPE — reporter pipe-close, not test failure)"
    fi
}

for i in $(seq 1 $total_shards); do
    for_each_exit_check "e2e shard $i/$total_shards" "${shard_exits[$i]}"
done

MAX_LINES=400
echo "Checking file sizes..."
oversized=""
while IFS= read -r f; do
    lines=$(wc -l < "$f")
    if [ "$lines" -gt "$MAX_LINES" ]; then
        oversized="${oversized}  ${f}: ${lines} lines (max ${MAX_LINES})\n"
    fi
done < <(find applications/*/src -name "*.rs" -not -name "*test*" -not -path "*/target/*" -not -path "*/node_modules/*")
if [ -n "$oversized" ]; then
    echo "WARNING: Files exceed ${MAX_LINES}-line limit:"
    echo -e "$oversized"
    echo "Consider splitting before the next push."
fi

echo "All checks passed."
