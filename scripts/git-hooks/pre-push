#!/bin/bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -d "$REPO_ROOT/applications/electron/node_modules" ]; then
    echo "ERROR: applications/electron/node_modules not found at $REPO_ROOT." >&2
    echo "Install with: (cd $REPO_ROOT/applications/electron && npm install)" >&2
    exit 1
fi

echo "Running pre-push quality gates (6 Playwright shards sequentially, workers=3)..."

# Sequential shard execution (#1303 follow-up): parallel-hammer of 6
# shards × workers=3 = 18 concurrent procs on bpmux-mac-m1 saturated
# the host (WindowServer/GPU/CPU), causing shard-6 false-fails on
# load-sensitive tests (real-backend unfurls, avatar grouping,
# keyboard drag-reorder). #1253 moved CI's e2e to ubuntu-latest under
# the same diagnosis; the local pre-push gate kept the parallel shape
# and surfaced the same class. Sequential preserves the 6-shard
# coverage with bounded concurrency (3 procs at peak per shard).
# Trade-off: ~3min wall-clock vs the prior 1.5min flaky-parallel.

declare -a shard_logs shard_exits
total_shards=6
for i in $(seq 1 $total_shards); do
    shard_logs[$i]=$(mktemp)
    shard_exits[$i]=0
done

for i in $(seq 1 $total_shards); do
    log="${shard_logs[$i]}"
    set +e
    (cd "$REPO_ROOT/applications/electron" \
      && npx playwright test --reporter=dot \
           --shard="$i/$total_shards" --workers=3) \
      >"$log" 2>&1
    shard_exits[$i]=$?
    set -e
done

for i in $(seq 1 $total_shards); do
    echo "--- shard $i/$total_shards ---"
    cat "${shard_logs[$i]}"
    rm -f "${shard_logs[$i]}"
done

for_each_exit_check() {
    local label=$1 code=$2
    if [ $code -ne 0 ] && [ $code -ne 141 ]; then
        echo "FAIL: $label exited $code"
        exit $code
    fi
    if [ $code -eq 141 ]; then
        echo "WARN: $label exited 141 (SIGPIPE — reporter pipe-close, not test failure)"
    fi
}

for i in $(seq 1 $total_shards); do
    for_each_exit_check "e2e shard $i/$total_shards" "${shard_exits[$i]}"
done

MAX_LINES=400
echo "Checking file sizes..."
oversized=""
while IFS= read -r f; do
    lines=$(wc -l < "$f")
    if [ "$lines" -gt "$MAX_LINES" ]; then
        oversized="${oversized}  ${f}: ${lines} lines (max ${MAX_LINES})\n"
    fi
done < <(find applications/*/src -name "*.rs" -not -name "*test*" -not -path "*/target/*" -not -path "*/node_modules/*")
if [ -n "$oversized" ]; then
    echo "WARNING: Files exceed ${MAX_LINES}-line limit:"
    echo -e "$oversized"
    echo "Consider splitting before the next push."
fi

echo "All checks passed."
