#!/bin/bash
# Pre-push hook: Playwright e2e + file-size gate.
#
# Install: symlink or copy this file to .git/hooks/pre-push and make
# it executable.
#
# Restructure 2026-05-01: cargo nextest + npm test:unit + cargo
# audit moved to pre-commit (fast-feedback). Pre-push now runs ONLY
# npm test:e2e (the 12-min surface). Catches unit-class regressions
# at commit-time instead of push-time.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -d "$REPO_ROOT/applications/electron/node_modules" ]; then
    echo "ERROR: applications/electron/node_modules not found at $REPO_ROOT." >&2
    echo "Install with: (cd $REPO_ROOT/applications/electron && npm install)" >&2
    exit 1
fi

echo "Running pre-push quality gates..."

# #534 slice 2: Playwright e2e — Ryan 2026-04-28: "you need to run
# your e2e acceptance tests in your pre-push." Per spec falsifier #6
# (error-loud not silent-skip), the npm script returns non-zero on
# any test failure or browser-env-missing so pre-push gates correctly.
# `--reporter=dot` keeps stdout volume low (one char per test) on
# green runs; failures still print full context. Reduces hook stdout
# from ~277 per-test lines to ~3 dot-rows + summary.
e2e_exit=0
(cd "$REPO_ROOT/applications/electron" && npm run test:e2e -- --reporter=dot) || e2e_exit=$?
if [ $e2e_exit -ne 0 ] && [ $e2e_exit -ne 141 ]; then
    exit $e2e_exit
fi
if [ $e2e_exit -eq 141 ]; then
    echo "WARN: test:e2e exited 141 (SIGPIPE — reporter pipe-close, not test failure)"
fi

MAX_LINES=400
echo "Checking file sizes..."
oversized=""
while IFS= read -r f; do
    lines=$(wc -l < "$f")
    if [ "$lines" -gt "$MAX_LINES" ]; then
        oversized="${oversized}  ${f}: ${lines} lines (max ${MAX_LINES})\n"
    fi
done < <(find applications/*/src -name "*.rs" -not -name "*test*" -not -path "*/target/*" -not -path "*/node_modules/*")
if [ -n "$oversized" ]; then
    echo "WARNING: Files exceed ${MAX_LINES}-line limit:"
    echo -e "$oversized"
    echo "Consider splitting before the next push."
fi

echo "All checks passed."
