#!/bin/bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -d "$REPO_ROOT/applications/electron/node_modules" ]; then
    echo "ERROR: applications/electron/node_modules not found at $REPO_ROOT." >&2
    echo "Install with: (cd $REPO_ROOT/applications/electron && npm install)" >&2
    exit 1
fi

# Build first so the e2e launches CURRENT source, not a stale out/. The hook runs
# `npx playwright test` directly (to control --project/--workers), which bypasses
# the `pretest:e2e` build — without this, a renderer change pushed without a manual
# build is silently tested against the previous build (false green AND false red).
echo "Building the electron app (so the e2e exercises current source)..."
(cd "$REPO_ROOT/applications/electron" && npm run build)

echo "Running pre-push quality gates (serial heavy specs at workers=1, main at workers=4 parallel)..."

# Main e2e now runs PARALLEL (workers=4, unsharded). Each spec launches
# its own electron+backend pair; workers>1 was historically flaky from
# per-test-pair contention — but grounding it (full main at workers=4:
# 301/1) showed the only failure was a terminal-restore fetch that gave
# up on a transient failure, FIXED in f6feb009 (it now retries). With
# that nature-flake cured + retries=1 absorbing rare timing blips, the
# owner accepted the reliability tradeoff to reclaim the ~3-4x: a full
# main run is ~2.2min at workers=4 vs ~7-10min at the old sequential
# workers=1. The `serial` heavy specs (real-backend/a11y/canary) stay
# workers=1 — they're CPU-heavy + intentionally isolated.

serial_log=$(mktemp)
set +e
(cd "$REPO_ROOT/applications/electron" \
  && npx playwright test --reporter=dot --project=serial --workers=1) \
  >"$serial_log" 2>&1
serial_exit=$?
set -e

main_log=$(mktemp)
set +e
(cd "$REPO_ROOT/applications/electron" \
  && npx playwright test --reporter=dot --project=main --workers=4) \
  >"$main_log" 2>&1
main_exit=$?
set -e

echo "--- serial (workers=1) ---"
cat "$serial_log"
rm -f "$serial_log"

echo "--- main (workers=4) ---"
cat "$main_log"
rm -f "$main_log"

for_each_exit_check() {
    local label=$1 code=$2
    if [ $code -ne 0 ] && [ $code -ne 141 ]; then
        echo "FAIL: $label exited $code"
        exit $code
    fi
    if [ $code -eq 141 ]; then
        echo "WARN: $label exited 141 (SIGPIPE — reporter pipe-close, not test failure)"
    fi
}

for_each_exit_check "e2e serial (workers=1)" "$serial_exit"
for_each_exit_check "e2e main (workers=4)" "$main_exit"

MAX_LINES=200
echo "Checking file sizes (max ${MAX_LINES} lines; hard fail)..."

# Size-gate allowlist (#20 decompose; Ryan 2026-06-19: "set the gate at 200,
# we can talk about the others after"). Each entry is ONE indivisible unit with
# no honest vertical seam — a single trait-impl block, a match-dispatch /
# state-machine, a declarative enum + its exhaustive matches, a catalog literal,
# or crate-root/server wiring. Splitting any of these would scatter cohesion to
# hit a number. Add here only with a one-line reason; prefer splitting.
size_gate_allowlisted() {
    case "$1" in
        applications/bpmux/src/product_management/story/events.rs) return 0 ;; # StoryEvent: one declarative enum + its exhaustive meta()/story_id() matches; nesting would ripple to every construction + match site
        applications/bpmux/src/bridge/connection.rs) return 0 ;;              # run_ws_connection: one connect/identify/receive async state-machine loop over shared loop-state
        applications/bpmux/src/transport/ws/mod.rs) return 0 ;;               # run_ws_session: one select! loop; branches share heavy mutable loop-state (cutting = param-threading noise)
        applications/bpmux/src/storage/instrumented.rs) return 0 ;;   # single `impl Storage for InstrumentedStorage` block (decorator); Rust can't split one trait impl across files
        applications/bpmux/src/storage/session/mod.rs) return 0 ;;    # single `impl Storage for FileStorage` block (file-backed prod store); Rust can't split one trait impl across files
    esac
    return 1
}

oversized=""
while IFS= read -r f; do
    if size_gate_allowlisted "$f"; then
        continue
    fi
    lines=$(wc -l < "$f")
    if [ "$lines" -gt "$MAX_LINES" ]; then
        oversized="${oversized}  ${f}: ${lines} lines (max ${MAX_LINES})\n"
    fi
done < <(find applications/*/src -name "*.rs" -not -name "*test*" -not -path "*/target/*" -not -path "*/node_modules/*" -not -path "*_tests/*")
if [ -n "$oversized" ]; then
    echo "FAIL: files exceed the ${MAX_LINES}-line limit. Split by cohesion into capability submodules, or (only if genuinely indivisible) add to size_gate_allowlisted with a one-line reason:"
    echo -e "$oversized"
    exit 1
fi

echo "All checks passed."
