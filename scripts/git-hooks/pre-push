#!/bin/bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -d "$REPO_ROOT/applications/electron/node_modules" ]; then
    echo "ERROR: applications/electron/node_modules not found at $REPO_ROOT." >&2
    echo "Install with: (cd $REPO_ROOT/applications/electron && npm install)" >&2
    exit 1
fi

echo "Running pre-push quality gates (serial heavy specs at workers=1, then 6 main shards at workers=3)..."

# The heaviest specs (real-backend spawns a full bpmux backend per
# test; a11y-audit walks the whole DOM) are serial-isolated into a
# workers=1 pass via the `serial` playwright project, so they don't
# contend at 3-way parallelism. That contention (3 real-backends at
# once under host saturation) manufactured timeout + worker-crash +
# render-variance false-fails — every spec passes at workers=1; the
# gate flaked only under workers=3 contention. The `main` project
# (testIgnore those specs) keeps the 6-shard workers=3 coverage.
# Sequential shard execution (#1303) bounds concurrency further.

serial_log=$(mktemp)
set +e
(cd "$REPO_ROOT/applications/electron" \
  && npx playwright test --reporter=dot --project=serial --workers=1) \
  >"$serial_log" 2>&1
serial_exit=$?
set -e

declare -a shard_logs shard_exits
total_shards=6
for i in $(seq 1 $total_shards); do
    shard_logs[$i]=$(mktemp)
    shard_exits[$i]=0
done

for i in $(seq 1 $total_shards); do
    log="${shard_logs[$i]}"
    set +e
    (cd "$REPO_ROOT/applications/electron" \
      && npx playwright test --reporter=dot --project=main \
           --shard="$i/$total_shards" --workers=3) \
      >"$log" 2>&1
    shard_exits[$i]=$?
    set -e
done

echo "--- serial (workers=1) ---"
cat "$serial_log"
rm -f "$serial_log"

for i in $(seq 1 $total_shards); do
    echo "--- shard $i/$total_shards ---"
    cat "${shard_logs[$i]}"
    rm -f "${shard_logs[$i]}"
done

for_each_exit_check() {
    local label=$1 code=$2
    if [ $code -ne 0 ] && [ $code -ne 141 ]; then
        echo "FAIL: $label exited $code"
        exit $code
    fi
    if [ $code -eq 141 ]; then
        echo "WARN: $label exited 141 (SIGPIPE — reporter pipe-close, not test failure)"
    fi
}

for_each_exit_check "e2e serial (workers=1)" "$serial_exit"
for i in $(seq 1 $total_shards); do
    for_each_exit_check "e2e shard $i/$total_shards" "${shard_exits[$i]}"
done

MAX_LINES=400
echo "Checking file sizes..."
oversized=""
while IFS= read -r f; do
    lines=$(wc -l < "$f")
    if [ "$lines" -gt "$MAX_LINES" ]; then
        oversized="${oversized}  ${f}: ${lines} lines (max ${MAX_LINES})\n"
    fi
done < <(find applications/*/src -name "*.rs" -not -name "*test*" -not -path "*/target/*" -not -path "*/node_modules/*")
if [ -n "$oversized" ]; then
    echo "WARNING: Files exceed ${MAX_LINES}-line limit:"
    echo -e "$oversized"
    echo "Consider splitting before the next push."
fi

echo "All checks passed."
