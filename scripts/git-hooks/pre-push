#!/bin/bash
# Pre-push: THE full gate. The Playwright e2e runs ONLY here — never in CI —
# and the self-hosted CI runners are not guaranteed up (they ride the same
# machinery bpmux itself runs on). A push must therefore prove everything
# locally: unit tests (Rust + renderer), e2e, lint, and type checking. The
# pre-commit hook remains the fast commit-time loop; this hook does not trust
# that every pushed commit went through it (commits can arrive via --no-verify
# or a clone without hooks activated).
#
# Activate per-clone with: git config core.hooksPath scripts/git-hooks
# (hook-source updates then take effect on pull — no stale .git/hooks copies).
set -euo pipefail

if [ -f "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
fi

if ! command -v cargo &> /dev/null; then
    echo "ERROR: cargo not found. Install Rust: https://rustup.rs" >&2
    exit 1
fi

if ! command -v cargo-nextest &> /dev/null; then
    echo "ERROR: cargo-nextest not found. Install: cargo install cargo-nextest --locked" >&2
    exit 1
fi

if ! command -v cargo-machete &> /dev/null; then
    echo "ERROR: cargo-machete not found. Install: cargo install cargo-machete --locked" >&2
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -d "$REPO_ROOT/applications/electron/node_modules" ]; then
    echo "ERROR: applications/electron/node_modules not found at $REPO_ROOT." >&2
    echo "Install with: (cd $REPO_ROOT/applications/electron && npm install)" >&2
    exit 1
fi

# eslint/stylelint cover the files this push introduces or changes (same
# touch-it-fix-it model as the staged-file commit gate — the dormant lint
# baseline in untouched files doesn't block). The push range comes from the
# stdin lines git feeds pre-push; `make pre-push` has no stdin ranges and
# falls back to origin/main..HEAD.
zero="0000000000000000000000000000000000000000"
pushed_files=""
if [ -t 0 ]; then
    base=$(git merge-base origin/main HEAD 2>/dev/null || echo "")
    [ -n "$base" ] && pushed_files=$(git diff --name-only "$base" HEAD)
else
    while read -r _local_ref local_sha _remote_ref remote_sha; do
        [ "$local_sha" = "$zero" ] && continue
        if [ "$remote_sha" = "$zero" ]; then
            base=$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "")
        else
            base="$remote_sha"
        fi
        [ -n "$base" ] && pushed_files+="$(git diff --name-only "$base" "$local_sha")"$'\n'
    done
fi

lint_pushed_electron_files() {
    local ts_files css_files ts_exit=0 css_exit=0
    ts_files=$(echo "$pushed_files" \
        | grep -E '^applications/electron/(src|tests)/.*\.(ts|tsx)$' \
        | sed 's|^applications/electron/||' | sort -u \
        | while IFS= read -r f; do [ -f "$REPO_ROOT/applications/electron/$f" ] && echo "$f"; done || true)
    css_files=$(echo "$pushed_files" \
        | grep -E '^applications/electron/src/.*\.css$' \
        | sed 's|^applications/electron/||' | sort -u \
        | while IFS= read -r f; do [ -f "$REPO_ROOT/applications/electron/$f" ] && echo "$f"; done || true)
    cd "$REPO_ROOT/applications/electron"
    if [ -n "$ts_files" ]; then
        echo "$ts_files" | xargs -r npx eslint --no-warn-ignored --max-warnings 0 || ts_exit=$?
    fi
    if [ -n "$css_files" ]; then
        echo "$css_files" | xargs -r npx stylelint || css_exit=$?
    fi
    [ $ts_exit -ne 0 ] && return $ts_exit
    return $css_exit
}

echo "Running pre-push quality gates, wave 1 (parallel): fmt, clippy, nextest, electron build+typecheck, npm unit, comment gate, lint..."

registered_canary_before=0
if [ -f "$HOME/.bpmux/diag.log" ]; then
    registered_canary_before=$(grep -c "Routing.Registered" "$HOME/.bpmux/diag.log" || true)
fi


fmt_log=$(mktemp); fmt_exit=0
clippy_log=$(mktemp); clippy_exit=0
nextest_log=$(mktemp); nextest_exit=0
build_log=$(mktemp); build_exit=0
unit_log=$(mktemp); unit_exit=0
depcruise_log=$(mktemp); depcruise_exit=0
inline_log=$(mktemp); inline_exit=0
lint_log=$(mktemp); lint_exit=0

cargo fmt --check >"$fmt_log" 2>&1 &
fmt_pid=$!

cargo clippy --workspace --all-targets -- -D warnings >"$clippy_log" 2>&1 &
clippy_pid=$!

env -u BPMUX_PORT -u BPMUX_TERMINAL_ID -u BPMUX_USER_ID -u BPMUX_ROLE -u BPMUX_DATA_BASE cargo nextest run --no-fail-fast --retries 1 --status-level fail --hide-progress-bar >"$nextest_log" 2>&1 &
nextest_pid=$!

# `npm run build` = typecheck (tsc node+web) + electron-vite build. Building in
# wave 1 both runs the type checking gate and guarantees the e2e below launches
# CURRENT source, not a stale out/ (the hook calls `npx playwright test`
# directly to control --project/--workers, which bypasses `pretest:e2e`).
(cd "$REPO_ROOT/applications/electron" && npm run build) >"$build_log" 2>&1 &
build_pid=$!

(cd "$REPO_ROOT/applications/electron" && env -u BPMUX_PORT -u BPMUX_TERMINAL_ID -u BPMUX_USER_ID -u BPMUX_ROLE -u BPMUX_DATA_BASE npm run test:unit) >"$unit_log" 2>&1 &
unit_pid=$!

{ (cd "$REPO_ROOT/applications/electron" && npm run depcruise && npx knip) && cargo machete; } >"$depcruise_log" 2>&1 &
depcruise_pid=$!

"$REPO_ROOT/scripts/check-inline-comments.sh" >"$inline_log" 2>&1 &
inline_pid=$!

lint_pushed_electron_files >"$lint_log" 2>&1 &
lint_pid=$!

wait $fmt_pid || fmt_exit=$?
wait $clippy_pid || clippy_exit=$?
wait $nextest_pid || nextest_exit=$?
wait $build_pid || build_exit=$?
wait $unit_pid || unit_exit=$?
wait $depcruise_pid || depcruise_exit=$?
wait $inline_pid || inline_exit=$?
wait $lint_pid || lint_exit=$?

echo "--- cargo fmt ---"; cat "$fmt_log"
echo "--- cargo clippy ---"; cat "$clippy_log"
echo "--- cargo nextest ---"; cat "$nextest_log"
if grep -qE "FLAKY|flaky" "$nextest_log" 2>/dev/null; then
    echo "=============================================================="
    echo "WARNING: FLAKY test(s) passed only on retry — see the nextest log above."
    echo "Flaky tests are serious problems (canon). Hunt it, don't ship it silently."
    echo "=============================================================="
fi
echo "--- electron build + typecheck ---"; cat "$build_log"
echo "--- architecture signals (depcruise + knip + machete) ---"; cat "$depcruise_log"
echo "--- npm test:unit ---"; cat "$unit_log"
echo "--- comment-class gate ---"; cat "$inline_log"
echo "--- eslint + stylelint (pushed files) ---"; cat "$lint_log"
rm -f "$fmt_log" "$clippy_log" "$nextest_log" "$build_log" "$unit_log" "$inline_log" "$lint_log" "$depcruise_log"

# Treat 141 (SIGPIPE) as warn-not-fail per #1135 — reporters can SIGPIPE on
# stdout pipe-close even when all tests pass.
for_each_exit_check() {
    local label=$1 code=$2
    if [ $code -ne 0 ] && [ $code -ne 141 ]; then
        echo "FAIL: $label exited $code"
        exit $code
    fi
    if [ $code -eq 141 ]; then
        echo "WARN: $label exited 141 (SIGPIPE — reporter pipe-close, not test failure)"
    fi
}

[ $fmt_exit -ne 0 ] && exit $fmt_exit
[ $clippy_exit -ne 0 ] && exit $clippy_exit
for_each_exit_check "cargo nextest" "$nextest_exit"
[ $build_exit -ne 0 ] && exit $build_exit
for_each_exit_check "npm test:unit" "$unit_exit"
[ $depcruise_exit -ne 0 ] && { echo "FAIL: architecture signals"; exit $depcruise_exit; }
[ $inline_exit -ne 0 ] && exit $inline_exit
[ $lint_exit -ne 0 ] && exit $lint_exit

# Lighthouse floor on the renderer wave 1 just built (same config CI asserts:
# a11y 1.0, best-practices 0.85). Local rendering differs from the Linux
# runner (fonts, compositing) so CI keeps the final word — this catches the
# structural failures (missing meta, DOM-level a11y) without a CI round-trip.
echo "Running pre-push quality gates: Lighthouse floor on the built renderer..."
lhci_log=$(mktemp)
set +e
(cd "$REPO_ROOT/applications/electron" && npx --yes @lhci/cli@0.14.x autorun --config=lighthouserc.json) >"$lhci_log" 2>&1
lhci_exit=$?
set -e
echo "--- lighthouse (built renderer) ---"; cat "$lhci_log"; rm -f "$lhci_log"
[ $lhci_exit -ne 0 ] && { echo "FAIL: Lighthouse floor — run 'npx @lhci/cli autorun --config=lighthouserc.json' in applications/electron to see the audits"; exit $lhci_exit; }

echo "Running pre-push quality gates, wave 2: e2e (serial heavy specs at workers=1, main at workers=4 parallel)..."

# Main e2e runs PARALLEL (workers=4, unsharded). Each spec launches
# its own electron+backend pair; workers>1 was historically flaky from
# per-test-pair contention — but grounding it (full main at workers=4:
# 301/1) showed the only failure was a terminal-restore fetch that gave
# up on a transient failure, FIXED in f6feb009 (it now retries). With
# that nature-flake cured + retries=1 absorbing rare timing blips, the
# owner accepted the reliability tradeoff to reclaim the ~3-4x: a full
# main run is ~2.2min at workers=4 vs ~7-10min at the old sequential
# workers=1. The `serial` heavy specs (real-backend/a11y/canary) stay
# workers=1 — they're CPU-heavy + intentionally isolated.

serial_log=$(mktemp)
set +e
(cd "$REPO_ROOT/applications/electron" \
  && env -u BPMUX_PORT -u BPMUX_TERMINAL_ID -u BPMUX_USER_ID -u BPMUX_ROLE -u BPMUX_DATA_BASE npx playwright test --reporter=dot --project=serial --workers=1) \
  >"$serial_log" 2>&1
serial_exit=$?
set -e

main_log=$(mktemp)
set +e
(cd "$REPO_ROOT/applications/electron" \
  && env -u BPMUX_PORT -u BPMUX_TERMINAL_ID -u BPMUX_USER_ID -u BPMUX_ROLE -u BPMUX_DATA_BASE npx playwright test --reporter=dot --project=main --workers=4) \
  >"$main_log" 2>&1
main_exit=$?
set -e


for flake_log in "$serial_log" "$main_log"; do
    if grep -qE "[0-9]+ flaky" "$flake_log" 2>/dev/null; then
        echo "=============================================================="
        echo "WARNING: FLAKY e2e test(s) passed only on retry — see above."
        echo "Flaky tests are serious problems (canon). Hunt it, don't ship it silently."
        echo "=============================================================="
    fi
done
echo "--- serial (workers=1) ---"
cat "$serial_log"
rm -f "$serial_log"

echo "--- main (workers=4) ---"
cat "$main_log"
rm -f "$main_log"

for_each_exit_check "e2e serial (workers=1)" "$serial_exit"
for_each_exit_check "e2e main (workers=4)" "$main_exit"

MAX_LINES=200
echo "Checking file sizes (max ${MAX_LINES} lines; hard fail)..."

# A file whose only `mod <name>;` registration in its parent module sits under
# #[cfg(test)] is a test module wearing a behavior-named filename, not production.
is_test_only_module() {
    local f="$1" dir base modname parent
    dir=$(dirname "$f")
    base=$(basename "$f")
    modname=$(basename "$f" .rs)
    for parent in "$dir/mod.rs" "$(dirname "$dir")/$(basename "$dir").rs" "$dir/lib.rs"; do
        [ -f "$parent" ] || continue
        if awk -v modname="$modname" -v base="$base" '
            /^[[:space:]]*#\[/ { attrs = attrs $0 "\n"; next }
            {
                if (($0 ~ ("mod[ \t]+" modname "[ \t]*;") || attrs ~ ("path[ \t]*=[ \t]*\"" base "\"")) \
                    && attrs ~ /cfg\(test\)/) { print "MATCH"; exit }
                attrs = ""
            }
        ' "$parent" | grep -q MATCH; then
            return 0
        fi
    done
    return 1
}

oversized=""
while IFS= read -r f; do
    is_test_only_module "$f" && continue
    lines=$(wc -l < "$f")
    if [ "$lines" -gt "$MAX_LINES" ]; then
        oversized="${oversized}  ${f}: ${lines} lines (max ${MAX_LINES})\n"
    fi
done < <(find applications/*/src components/*/src -name "*.rs" -not -name "*test*" -not -path "*/target/*" -not -path "*/node_modules/*" -not -path "*_tests/*")
if [ -n "$oversized" ]; then
    echo "FAIL: files exceed the ${MAX_LINES}-line limit. Split by cohesion into capability submodules:"
    echo -e "$oversized"
    exit 1
fi


if [ -f "$HOME/.bpmux/diag.log" ]; then
    registered_canary_after=$(grep -c "Routing.Registered" "$HOME/.bpmux/diag.log" || true)
    if [ "$registered_canary_after" -gt "$registered_canary_before" ]; then
        echo "FAIL: live-daemon canary — the LIVE daemon registered $((registered_canary_after - registered_canary_before)) new identit(y/ies) during the gate run."
        echo "A test or tool leaked onto the live daemon (ambient port/terminal env, or a hardcoded 4117)."
        echo "If a human genuinely registered mid-run, re-run to confirm."
        exit 1
    fi
fi

echo "All checks passed."
