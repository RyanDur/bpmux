#!/bin/bash
# Post-commit hook (#424): broadcast a pre-commit-gates-passed activity
# message to the bpmux session after each successful commit. Only fires
# on gate-passed state because the commit wouldn't exist if pre-commit
# had failed.
#
# Install: symlink or copy this file to .git/hooks/post-commit and make
# it executable. Out of scope for this story is automated installation.
#
# The POST is best-effort: a 500ms timeout, failures are swallowed. If
# the bpmux server isn't running, teammates simply won't see the
# broadcast for that commit.
set -euo pipefail

SHA="$(git rev-parse HEAD 2>/dev/null || echo "")"
[ -z "$SHA" ] && exit 0

# Resolve the bpmux binary. Dev workflow iterates on debug builds; a
# stale target/release (from an earlier release build) would shadow the
# current subcommand surface. Try each in mtime-agnostic order but fall
# through on failure so a stale binary doesn't swallow the signal.
try_emit() {
    local bin="$1"
    [ -x "$bin" ] || return 1
    "$bin" emit-precommit-passed --sha "$SHA" 2>/dev/null
}

try_emit "target/debug/bpmux" && exit 0
try_emit "target/release/bpmux" && exit 0
if command -v bpmux &>/dev/null; then
    bpmux emit-precommit-passed --sha "$SHA" 2>/dev/null || true
fi
exit 0
