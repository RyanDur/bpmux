#!/bin/bash
# Pre-commit hook: fast-feedback structural + unit-test gates.
#
# Install: symlink or copy this file to .git/hooks/pre-commit and
# make it executable.
#
# Restructure 2026-05-01: cargo nextest + npm test:unit + cargo
# audit moved here from pre-push. Pre-push re-runs the full set
# PLUS the e2e (it is the only gate when CI runners are down). Catches unit-class regressions at
# commit-time instead of push-time, saving a 12-min round trip when
# a unit test breaks.
#
# Wall-clock target: <60s on green runs (parallel execution of
# fmt + clippy + nextest + npm test:unit; cargo audit serial after).
set -euo pipefail

if [ -f "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
fi

if ! command -v cargo &> /dev/null; then
    echo "ERROR: cargo not found. Install Rust: https://rustup.rs" >&2
    exit 1
fi

if ! command -v cargo-nextest &> /dev/null; then
    echo "ERROR: cargo-nextest not found. Install: cargo install cargo-nextest --locked" >&2
    exit 1
fi

if ! command -v cargo-machete &> /dev/null; then
    echo "ERROR: cargo-machete not found. Install: cargo install cargo-machete --locked" >&2
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -d "$REPO_ROOT/applications/electron/node_modules" ]; then
    echo "ERROR: applications/electron/node_modules not found at $REPO_ROOT." >&2
    echo "Install with: (cd $REPO_ROOT/applications/electron && npm install)" >&2
    exit 1
fi

echo "Running pre-commit quality gates (parallel)..."

registered_canary_before=0
if [ -f "$HOME/.bpmux/diag.log" ]; then
    registered_canary_before=$(grep -c "Routing.Registered" "$HOME/.bpmux/diag.log" || true)
fi


fmt_log=$(mktemp); fmt_exit=0
clippy_log=$(mktemp); clippy_exit=0
nextest_log=$(mktemp); nextest_exit=0
unit_log=$(mktemp); unit_exit=0
signals_log=$(mktemp); signals_exit=0
inline_log=$(mktemp); inline_exit=0
lint_log=$(mktemp); lint_exit=0

cargo fmt --check >"$fmt_log" 2>&1 &
fmt_pid=$!

cargo clippy --lib --tests -- -D warnings -D clippy::cognitive_complexity -D clippy::excessive_nesting -D clippy::fn_params_excessive_bools -D clippy::struct_excessive_bools -D clippy::too_many_lines >"$clippy_log" 2>&1 &
clippy_pid=$!

env -u BPMUX_PORT -u BPMUX_TERMINAL_ID -u BPMUX_USER_ID -u BPMUX_ROLE -u BPMUX_DATA_BASE cargo nextest run --no-fail-fast --retries 1 --status-level fail --hide-progress-bar >"$nextest_log" 2>&1 &
nextest_pid=$!

(cd "$REPO_ROOT/applications/electron" && env -u BPMUX_PORT -u BPMUX_TERMINAL_ID -u BPMUX_USER_ID -u BPMUX_ROLE -u BPMUX_DATA_BASE npm run test:unit) >"$unit_log" 2>&1 &
unit_pid=$!

{ (cd "$REPO_ROOT/applications/electron" && npm run depcruise && npx knip) && cargo machete; } >"$signals_log" 2>&1 &
signals_pid=$!

"$REPO_ROOT/scripts/check-inline-comments.sh" >"$inline_log" 2>&1 &
inline_pid=$!

"$REPO_ROOT/scripts/lint-staged.sh" >"$lint_log" 2>&1 &
lint_pid=$!

wait $fmt_pid || fmt_exit=$?
wait $clippy_pid || clippy_exit=$?
wait $nextest_pid || nextest_exit=$?
wait $unit_pid || unit_exit=$?
wait $signals_pid || signals_exit=$?
wait $inline_pid || inline_exit=$?
wait $lint_pid || lint_exit=$?

# Print logs in deterministic order so failure context is easy to
# scan regardless of which finished first.
echo "--- cargo fmt ---"; cat "$fmt_log"
echo "--- cargo clippy ---"; cat "$clippy_log"
echo "--- cargo nextest ---"; cat "$nextest_log"
if grep -qE "FLAKY|flaky" "$nextest_log" 2>/dev/null; then
    echo "=============================================================="
    echo "WARNING: FLAKY test(s) passed only on retry — see the nextest log above."
    echo "Flaky tests are serious problems (canon). Hunt it, don't ship it silently."
    echo "=============================================================="
fi
echo "--- npm test:unit ---"; cat "$unit_log"
echo "--- architecture signals (depcruise + knip + machete) ---"; cat "$signals_log"
echo "--- comment-class gate ---"; cat "$inline_log"
echo "--- eslint + stylelint (staged) ---"; cat "$lint_log"
rm -f "$fmt_log" "$clippy_log" "$nextest_log" "$unit_log" "$inline_log" "$lint_log" "$signals_log"

# Treat 141 (SIGPIPE) as warn-not-fail per #1135 — Playwright's
# vitest reporter can SIGPIPE on stdout pipe-close even when all
# tests pass.
[ $fmt_exit -ne 0 ] && { echo "FAIL: cargo fmt"; exit $fmt_exit; }
[ $clippy_exit -ne 0 ] && { echo "FAIL: cargo clippy"; exit $clippy_exit; }
[ $nextest_exit -ne 0 ] && [ $nextest_exit -ne 141 ] && { echo "FAIL: cargo nextest"; exit $nextest_exit; }
if [ $nextest_exit -eq 141 ]; then
    echo "WARN: cargo nextest exited 141 (SIGPIPE — reporter pipe-close, not test failure)"
fi
[ $signals_exit -ne 0 ] && { echo "FAIL: architecture signals"; exit $signals_exit; }
[ $unit_exit -ne 0 ] && [ $unit_exit -ne 141 ] && { echo "FAIL: npm test:unit"; exit $unit_exit; }
if [ $unit_exit -eq 141 ]; then
    echo "WARN: npm test:unit exited 141 (SIGPIPE — reporter pipe-close, not test failure)"
fi
[ $inline_exit -ne 0 ] && { echo "FAIL: comment-class gate"; exit $inline_exit; }
[ $lint_exit -ne 0 ] && { echo "FAIL: eslint + stylelint (staged)"; exit $lint_exit; }

# cargo audit runs sequentially after parallel block — it locks the
# Cargo registry index briefly and parallel-cargo can deadlock.
if command -v cargo-audit &> /dev/null; then
    cargo audit --deny warnings
fi

echo "pre-commit: clean."

if [ -f "$HOME/.bpmux/diag.log" ]; then
    registered_canary_after=$(grep -c "Routing.Registered" "$HOME/.bpmux/diag.log" || true)
    if [ "$registered_canary_after" -gt "$registered_canary_before" ]; then
        echo "FAIL: live-daemon canary — the LIVE daemon registered $((registered_canary_after - registered_canary_before)) new identit(y/ies) during the pre-commit run."
        echo "A test or tool leaked onto the live daemon (ambient port/terminal env, or a hardcoded 4117)."
        echo "If a human genuinely registered mid-run, re-run to confirm."
        exit 1
    fi
fi

exit 0
